{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "meetily",
  "version": "0.4.2",
  "identifier": "com.meetily.ai",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3118",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "meetily",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "decorations": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data:",
        "media-src": "'self' asset: https://asset.localhost",
        "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai https://uplink.dev.hanfatong.com https://uplink.internal.hanfatong.com"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/app_icon.icns",
      "icons/app_icon.ico"
    ],
    "resources": [
      "templates/*.json"
    ],
    "externalBin": [
      "binaries/llama-helper",
      "binaries/ffmpeg"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwQjFEN0Y5MTI1QTJCNApSV1Mwb2lXUmZ4MExCbFNKVWh5NCtIU3p0NjBjZlgzM1VzaHlYMHlLZmE3ei85d0psQVhmcVN1Swo=",
      "endpoints": [
        "https://uplink.internal.hanfatong.com/api/update-check/meetily-moss/stable/tauri/latest.json"
      ]
    }
  }
}
